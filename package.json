{
  "name": "simple-http-dump-server",
  "version": "1.0.0",
  "description": "Tiny HTTP server that answers every request with 200 and dumps it to stdout and, optionally, a JSON Lines file. A fake upstream for webhooks and client testing.",
  "main": "index.js",
  "bin": {
    "simple-http-dump-server": "index.js"
  },
  "files": [
    "index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ./index.js",
    "lint": "eslint .",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denis1stomin/simple-http-dump-server.git"
  },
  "keywords": [
    "http",
    "requests",
    "log",
    "logger",
    "dump",
    "dumper",
    "server",
    "webhook",
    "mock"
  ],
  "author": "Denis Istomin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/denis1stomin/simple-http-dump-server/issues"
  },
  "homepage": "https://github.com/denis1stomin/simple-http-dump-server#readme",
  "dependencies": {
    "bytes": "^3.1.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0"
  }
}
